@page "/"
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>YoutubeSummarizer</PageTitle>

<div class="landing">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error alert-dismissable" style="max-width: 700px; margin: 0 auto 1rem;">
            <span>@errorMessage</span>
            <button class="alert-close" @onclick="DismissError">&times;</button>
        </div>
    }

    <div class="hero">
        <h1 class="hero-title">YouTube, summarized</h1>
        <p class="hero-subtitle">
            Track your favorite channels, get notified about new uploads,
            and read a quick summary before deciding to watch.
        </p>
        @if (!AuthState.IsLoggedIn)
        {
            <div class="hero-actions">
                <a href="/register" class="btn btn-primary">Sign up</a>
                <a href="/login" class="btn btn-secondary">Login</a>
            </div>
        }
    </div>

    <div class="features">
        <div class="feature-card">
            <h3>Channel tracking</h3>
            <p>Subscribe to channels and get notified when new videos drop.</p>
        </div>
        <div class="feature-card">
            <h3>Video summaries</h3>
            <p>Read a short summary of each video so you know what it's about before watching.</p>
        </div>
        <div class="feature-card">
            <h3>Topic filtering</h3>
            <p>Set up a blocklist to skip videos on topics you don't care about.</p>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var error = query["error"];
        if (!string.IsNullOrEmpty(error))
        {
            errorMessage = error switch
            {
                "unauthorized" => "You do not have permission to access that page.",
                _ => null
            };
        }
    }

    private void DismissError()
    {
        errorMessage = null;
        Navigation.NavigateTo("/", replace: true);
    }
}
