@page "/admin"
@inject AuthStateService AuthState
@inject AdminService AdminService
@inject NavigationManager Navigation

<PageTitle>YoutubeSummarizer - Admin Panel</PageTitle>

<div class="subscriptions-page">
    <div class="subscriptions-header">
        <h1>Admin Panel</h1>
        <p class="page-subtitle">Manage the application.</p>
    </div>

    <CollapsibleSection Title="Send Global Notification" Subtitle="This will be sent to all users." StartExpanded="false">
        @if (!string.IsNullOrEmpty(notifError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@notifError</span>
                <button class="alert-close" @onclick="() => notifError = null">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(notifSuccess))
        {
            <div class="alert alert-success alert-dismissable">
                <span>@notifSuccess</span>
                <button class="alert-close" @onclick="() => notifSuccess = null">&times;</button>
            </div>
        }

        <div class="form-group">
            <label for="notifTitle">Title</label>
            <input id="notifTitle" type="text" class="form-input" @bind="notifTitle" placeholder="Notification title" maxlength="200" />
        </div>

        <div class="form-group">
            <label for="notifContent">Content</label>
            <textarea id="notifContent" class="form-input form-textarea" @bind="notifContent" placeholder="Notification content" maxlength="2000" rows="4"></textarea>
        </div>

        <button class="btn btn-primary" @onclick="HandleSendNotification" disabled="@isSending">
            @(isSending ? "Sending..." : "Send Notification")
        </button>
    </CollapsibleSection>

    <CollapsibleSection Title="User Management" Subtitle="View and manage all users." StartExpanded="false">
        <div class="admin-toolbar">
            <button class="btn btn-secondary" @onclick="HandleRefreshUsers" disabled="@isRefreshing">
                @(isRefreshing ? "Refreshing..." : "Refresh")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(usersError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@usersError</span>
                <button class="alert-close" @onclick="() => usersError = null">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(usersSuccess))
        {
            <div class="alert alert-success alert-dismissable">
                <span>@usersSuccess</span>
                <button class="alert-close" @onclick="() => usersSuccess = null">&times;</button>
            </div>
        }

        @if (isLoadingUsers)
        {
            <p class="text-muted">Loading users...</p>
        }
        else if (users.Count == 0)
        {
            <p class="text-muted">No users found.</p>
        }
        else
        {
            <div class="admin-user-list">
                @foreach (var user in users)
                {
                    <div class="admin-user-card">
                        <button class="admin-user-header" @onclick="() => ToggleUser(user.Id)">
                            <div class="admin-user-info">
                                <span class="admin-user-name">@user.FirstName @user.LastName</span>
                                <span class="admin-user-email">@user.Email</span>
                            </div>
                            <div class="admin-user-actions">
                                <button class="btn btn-sm @(IsUserBanned(user.Id) ? "btn-success" : "btn-danger")" @onclick:stopPropagation="true" @onclick="() => ToggleBan(user.Id)">
                                    @(IsUserBanned(user.Id) ? "Unban" : "Ban")
                                </button>
                                <button class="btn btn-sm btn-warning" @onclick:stopPropagation="true" @onclick="() => HandleLogout(user)">
                                    Log Out
                                </button>
                                <span class="collapsible-chevron @(expandedUserIds.Contains(user.Id) ? "expanded" : "")">&#9660;</span>
                            </div>
                        </button>

                        @if (expandedUserIds.Contains(user.Id))
                        {
                            <div class="admin-user-body">
                                @if (user.Subscriptions.Count == 0)
                                {
                                    <p class="text-muted">No subscriptions.</p>
                                }
                                else
                                {
                                    <table class="admin-sub-table">
                                        <thead>
                                            <tr>
                                                <th>Channel</th>
                                                <th>Style</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var sub in user.Subscriptions)
                                            {
                                                <tr>
                                                    <td>@sub.ChannelName</td>
                                                    <td>@sub.SummarizationStyle</td>
                                                    <td>
                                                        <button class="btn-icon btn-icon-danger" @onclick="() => HandleCancelSubscription(user, sub)" title="Cancel subscription">
                                                            &times;
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </CollapsibleSection>

    <CollapsibleSection Title="Mock New Video" Subtitle="Simulate a PubSubHubbub notification for a YouTube video." StartExpanded="false">
        @if (!string.IsNullOrEmpty(mockError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@mockError</span>
                <button class="alert-close" @onclick="() => mockError = null">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(mockSuccess))
        {
            <div class="alert alert-success alert-dismissable">
                <span>@mockSuccess</span>
                <button class="alert-close" @onclick="() => mockSuccess = null">&times;</button>
            </div>
        }

        <div class="form-group">
            <label for="mockVideoUrl">YouTube Video URL</label>
            <input id="mockVideoUrl" type="text" class="form-input" @bind="mockVideoUrl" placeholder="https://www.youtube.com/watch?v=..." />
        </div>

        <button class="btn btn-primary" @onclick="HandleMockWebhook" disabled="@isMocking">
            @(isMocking ? "Submitting..." : "Submit")
        </button>
    </CollapsibleSection>
</div>

@code {
    private string notifTitle = string.Empty;
    private string notifContent = string.Empty;
    private string? notifError;
    private string? notifSuccess;
    private bool isSending;
    private bool isRefreshing;
    private bool isLoadingUsers;
    private string? usersError;
    private string? usersSuccess;

    private string mockVideoUrl = string.Empty;
    private string? mockError;
    private string? mockSuccess;
    private bool isMocking;

    private List<AdminUserModel> users = new();
    private HashSet<Guid> expandedUserIds = new();
    private HashSet<Guid> bannedUserIds = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!AuthState.IsAdmin)
        {
            Navigation.NavigateTo("/?error=unauthorized");
            return;
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoadingUsers = true;
        usersError = null;

        var result = await AdminService.GetAllUsersAsync();
        if (result.Success)
        {
            users = result.Users;
            bannedUserIds = users.Where(u => !u.IsActive).Select(u => u.Id).ToHashSet();
        }
        else
        {
            usersError = result.Error;
        }

        isLoadingUsers = false;
    }

    private async Task HandleRefreshUsers()
    {
        isRefreshing = true;
        ClearUserAlerts();
        expandedUserIds.Clear();
        await LoadUsers();
        isRefreshing = false;
    }

    private void ToggleUser(Guid userId)
    {
        if (!expandedUserIds.Remove(userId))
            expandedUserIds.Add(userId);
    }

    private bool IsUserBanned(Guid userId) => bannedUserIds.Contains(userId);

    private void ClearUserAlerts()
    {
        usersError = null;
        usersSuccess = null;
    }

    private async Task ToggleBan(Guid userId)
    {
        ClearUserAlerts();
        var result = await AdminService.ToggleBanAsync(userId);
        if (result.Success)
        {
            var wasBanned = bannedUserIds.Contains(userId);
            if (!bannedUserIds.Remove(userId))
                bannedUserIds.Add(userId);
            var user = users.FirstOrDefault(u => u.Id == userId);
            var name = user is not null ? $"{user.FirstName} {user.LastName}" : "User";
            usersSuccess = wasBanned ? $"{name} has been unbanned." : $"{name} has been banned.";
        }
        else
        {
            usersError = result.Error;
        }
    }

    private async Task HandleLogout(AdminUserModel user)
    {
        ClearUserAlerts();
        var result = await AdminService.LogOutUserAsync(user.Id);
        if (result.Success)
            usersSuccess = $"{user.FirstName} {user.LastName} has been logged out.";
        else
            usersError = result.Error;
    }

    private async Task HandleCancelSubscription(AdminUserModel user, AdminUserSubscriptionModel sub)
    {
        ClearUserAlerts();
        var result = await AdminService.CancelSubscriptionAsync(sub.SubscriptionId);
        if (result.Success)
        {
            user.Subscriptions.Remove(sub);
            usersSuccess = $"Subscription to {sub.ChannelName} cancelled for {user.FirstName} {user.LastName}.";
        }
        else
        {
            usersError = result.Error;
        }
    }

    private async Task HandleSendNotification()
    {
        notifError = null;
        notifSuccess = null;

        if (string.IsNullOrWhiteSpace(notifTitle) || string.IsNullOrWhiteSpace(notifContent))
        {
            notifError = "Title and content are required.";
            return;
        }

        isSending = true;
        var result = await AdminService.CreateGlobalNotificationAsync(notifTitle.Trim(), notifContent.Trim());

        if (result.Success)
        {
            notifSuccess = "Global notification sent to all users.";
            notifTitle = string.Empty;
            notifContent = string.Empty;
        }
        else
        {
            notifError = result.Error;
        }

        isSending = false;
    }

    private async Task HandleMockWebhook()
    {
        mockError = null;
        mockSuccess = null;

        if (string.IsNullOrWhiteSpace(mockVideoUrl))
        {
            mockError = "Please enter a YouTube video URL.";
            return;
        }

        isMocking = true;
        var result = await AdminService.MockWebhookAsync(mockVideoUrl.Trim());

        if (result.Success)
        {
            mockSuccess = result.Message ?? "Mock webhook sent successfully.";
            mockVideoUrl = string.Empty;
        }
        else
        {
            mockError = result.Error;
        }

        isMocking = false;
    }
}
