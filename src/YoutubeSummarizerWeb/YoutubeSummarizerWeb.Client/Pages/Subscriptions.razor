@page "/subscriptions"
@inject SubscriptionService SubscriptionService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Subscriptions - YoutubeSummarizer</PageTitle>

<div class="subscriptions-page">
    <div class="subscriptions-header">
        <h1>Your Subscriptions</h1>
        <p class="page-subtitle">Track YouTube channels and receive AI-powered summaries of new videos.</p>
    </div>

    <div class="subscribe-card">
        <h2>Subscribe to a Channel</h2>
        <p class="card-subtitle">Paste a YouTube channel link and choose how you'd like videos summarized.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@errorMessage</span>
                <button class="alert-close" @onclick="() => errorMessage = null">&times;</button>
            </div>
        }

        @if (successData is not null)
        {
            <div class="alert alert-success alert-dismissable">
                <span>Subscribed to <strong>@successData.ChannelIdentifier</strong>! You'll receive summaries for new uploads.</span>
                <button class="alert-close" @onclick="() => successData = null">&times;</button>
            </div>
        }

        <EditForm Model="model" OnValidSubmit="HandleSubscribe" FormName="subscribe">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="channelUrl">YouTube Channel URL</label>
                <InputText id="channelUrl"
                           @bind-Value="model.ChannelUrl"
                           class="form-input"
                           placeholder="https://youtube.com/c/channelname" />
                <ValidationMessage For="() => model.ChannelUrl" />
            </div>

            <div class="form-group">
                <label>Summarization Style</label>
                <div class="style-options">
                    @foreach (var style in Enum.GetValues<SummarizationStyle>())
                    {
                        var s = style;
                        <div class="style-option @(model.SummarizationStyle == s ? "selected" : "")"
                             @onclick="() => model.SummarizationStyle = s">
                            <span class="style-label">@s</span>
                            <span class="style-desc">@GetStyleDescription(s)</span>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                @(isLoading ? "Subscribing..." : "Subscribe")
            </button>
        </EditForm>
    </div>
    <div class="subscriptions-list-card">
        <h2>Your Current Subscriptions</h2>

        @if (isLoadingSubscriptions)
        {
            <p>Loading subscriptions...</p>
        }
        else if (subscriptions.Count == 0)
        {
            <p class="no-subscriptions">You haven't subscribed to any channels yet.</p>
        }
        else
        {
            <div class="subscriptions-list">
                @foreach (var sub in subscriptions)
                {
                    <div class="subscription-item">
                        <div class="subscription-info">
                            <span class="channel-name">@sub.ChannelIdentifier</span>
                            <div class="custom-dropdown">
                                <div class="custom-dropdown-trigger @(updatingStyleId == sub.SubscriptionId ? "disabled" : "")"
                                     @onclick="() => ToggleDropdown(sub.SubscriptionId)">
                                    <span>@sub.SummarizationStyle</span>
                                    <span class="dropdown-arrow">&#9662;</span>
                                </div>
                                @if (openDropdownId == sub.SubscriptionId)
                                {
                                    <div class="dropdown-overlay" @onclick="() => openDropdownId = null"></div>
                                    <div class="custom-dropdown-list">
                                        @foreach (var style in Enum.GetValues<SummarizationStyle>())
                                        {
                                            var s = style;
                                            <div class="custom-dropdown-item @(sub.SummarizationStyle == s ? "active" : "")"
                                                 @onclick="() => SelectStyle(sub, s)">
                                                @s
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <span class="subscription-date">Subscribed @sub.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
                        </div>
                        <button class="btn btn-danger"
                                disabled="@(deletingId == sub.SubscriptionId)"
                                @onclick="() => HandleUnsubscribe(sub.SubscriptionId)">
                            @(deletingId == sub.SubscriptionId ? "Removing..." : "Unsubscribe")
                        </button>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(unsubscribeSuccess))
        {
            <div class="alert alert-success alert-dismissable">
                <span>@unsubscribeSuccess</span>
                <button class="alert-close" @onclick="() => unsubscribeSuccess = null">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(unsubscribeError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@unsubscribeError</span>
                <button class="alert-close" @onclick="() => unsubscribeError = null">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(styleUpdateError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@styleUpdateError</span>
                <button class="alert-close" @onclick="() => styleUpdateError = null">&times;</button>
            </div>
        }
    </div>
</div>

@code {
    private SubscribeModel model = new();
    private string? errorMessage;
    private SubscribeResponse? successData;
    private bool isLoading;
    private List<UserSubscription> subscriptions = new();
    private bool isLoadingSubscriptions;
    private Guid? deletingId;
    private Guid? updatingStyleId;
    private Guid? openDropdownId;
    private string? unsubscribeError;
    private string? unsubscribeSuccess;
    private string? styleUpdateError;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadSubscriptions();
    }

    private async Task LoadSubscriptions()
    {
        isLoadingSubscriptions = true;
        subscriptions = await SubscriptionService.GetSubscriptionsAsync();
        isLoadingSubscriptions = false;
    }

    private async Task HandleSubscribe()
    {
        isLoading = true;
        errorMessage = null;
        successData = null;

        var result = await SubscriptionService.SubscribeAsync(model.ChannelUrl, model.SummarizationStyle);

        if (result.Success)
        {
            successData = result.Data;
            model = new();
            await LoadSubscriptions();
        }
        else
        {
            errorMessage = result.Error;
        }

        isLoading = false;
    }

    private async Task HandleUnsubscribe(Guid subscriptionId)
    {
        deletingId = subscriptionId;
        unsubscribeError = null;
        unsubscribeSuccess = null;

        var channelName = subscriptions.FirstOrDefault(s => s.SubscriptionId == subscriptionId)?.ChannelIdentifier;
        var result = await SubscriptionService.UnsubscribeAsync(subscriptionId);

        if (result.Success)
        {
            unsubscribeSuccess = $"Unsubscribed from {channelName}.";
            await LoadSubscriptions();
        }
        else
        {
            unsubscribeError = result.Error;
        }

        deletingId = null;
    }

    private void ToggleDropdown(Guid subscriptionId)
    {
        if (updatingStyleId == subscriptionId) return;
        openDropdownId = openDropdownId == subscriptionId ? null : subscriptionId;
    }

    private async Task SelectStyle(UserSubscription sub, SummarizationStyle newStyle)
    {
        openDropdownId = null;
        if (newStyle == sub.SummarizationStyle) return;

        updatingStyleId = sub.SubscriptionId;
        styleUpdateError = null;

        var result = await SubscriptionService.UpdateSummarizationStyleAsync(sub.SubscriptionId, newStyle);

        if (result.Success)
        {
            sub.SummarizationStyle = newStyle;
        }
        else
        {
            styleUpdateError = result.Error;
        }

        updatingStyleId = null;
    }

    private static string GetStyleDescription(SummarizationStyle style) => style switch
    {
        SummarizationStyle.Brief => "Short, key points only",
        SummarizationStyle.Detailed => "Full breakdown of topics",
        SummarizationStyle.Scientific => "Technical & structured",
        SummarizationStyle.Layman => "Simple, easy to read",
        _ => string.Empty
    };

    private class SubscribeModel
    {
        public string ChannelUrl { get; set; } = string.Empty;
        public SummarizationStyle SummarizationStyle { get; set; } = SummarizationStyle.Brief;
    }
}
