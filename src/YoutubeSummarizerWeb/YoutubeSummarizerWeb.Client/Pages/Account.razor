@page "/account"
@inject UserAccountService UserAccountService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>YoutubeSummarizer - Account</PageTitle>

<div class="subscriptions-page">
    <div class="subscriptions-header">
        <h1>My Account</h1>
        <p class="page-subtitle">Manage your account settings.</p>
    </div>

    <div class="subscribe-card">
        <h2>Keyword Blacklist</h2>
        <p class="card-subtitle">
            Videos matching any of these keywords will be marked as filtered in your notifications.
            Keywords are checked against the video title and transcript. You can add up to 50 keywords.
        </p>

        @if (!string.IsNullOrEmpty(addError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@addError</span>
                <button class="alert-close" @onclick="() => addError = null">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(addSuccess))
        {
            <div class="alert alert-success alert-dismissable">
                <span>@addSuccess</span>
                <button class="alert-close" @onclick="() => addSuccess = null">&times;</button>
            </div>
        }

        <div class="form-group">
            <label for="keyword">Add keyword</label>
            <div class="input-row">
                <input id="keyword"
                       class="form-input"
                       placeholder="e.g. crypto"
                       @bind="newKeyword"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />
                <button class="btn btn-primary"
                        disabled="@(isAdding || string.IsNullOrWhiteSpace(newKeyword))"
                        @onclick="HandleAdd">
                    @(isAdding ? "Adding..." : "Add")
                </button>
            </div>
        </div>

        @if (isLoadingKeywords)
        {
            <p>Loading keywords...</p>
        }
        else if (keywords.Count == 0)
        {
            <p class="no-subscriptions">Your blacklist is empty. Add a keyword above to get started.</p>
        }
        else
        {
            <div class="keyword-tags">
                @foreach (var kw in keywords)
                {
                    var kwRef = kw;
                    <span class="keyword-tag">
                        @kw.Keyword
                        <button class="keyword-tag-remove"
                                disabled="@(removingKeyword == kw.Keyword)"
                                @onclick="() => HandleRemove(kwRef)">&times;</button>
                    </span>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(removeError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@removeError</span>
                <button class="alert-close" @onclick="() => removeError = null">&times;</button>
            </div>
        }
    </div>

    <div class="subscribe-card">
        <h2>Delete Account</h2>
        <p class="card-subtitle">
            Permanently delete your account and all associated data. This action cannot be undone.
        </p>

        @if (!string.IsNullOrEmpty(deleteError))
        {
            <div class="alert alert-error alert-dismissable">
                <span>@deleteError</span>
                <button class="alert-close" @onclick="() => deleteError = null">&times;</button>
            </div>
        }

        <div class="form-group">
            <label for="delete-password">Confirm your password</label>
            <input id="delete-password"
                   type="password"
                   class="form-input"
                   placeholder="Enter your password"
                   @bind="deletePassword"
                   @bind:event="oninput" />
        </div>

        <div style="text-align: center">
            <button class="btn btn-danger"
                    disabled="@(isDeleting || string.IsNullOrWhiteSpace(deletePassword))"
                    @onclick="HandleDeleteAccount">
                @(isDeleting ? "Deleting..." : "Delete My Account")
            </button>
        </div>
    </div>
</div>

@code {
    private List<BlacklistEntry> keywords = new();
    private string newKeyword = string.Empty;
    private bool isLoadingKeywords;
    private bool isAdding;
    private string? removingKeyword;
    private string? addError;
    private string? addSuccess;
    private string? removeError;

    private string deletePassword = string.Empty;
    private bool isDeleting;
    private string? deleteError;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadKeywords();
    }

    private async Task LoadKeywords()
    {
        isLoadingKeywords = true;
        keywords = await UserAccountService.GetBlacklistEntriesAsync();
        isLoadingKeywords = false;
    }

    private async Task HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(newKeyword)) return;

        isAdding = true;
        addError = null;
        addSuccess = null;

        var result = await UserAccountService.AddBlacklistEntryAsync(newKeyword.Trim());

        if (result.Success)
        {
            addSuccess = $"\"{result.Keyword}\" added to your blacklist.";
            newKeyword = string.Empty;
            await LoadKeywords();
        }
        else
        {
            addError = result.Error;
        }

        isAdding = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleAdd();
    }

    private async Task HandleRemove(BlacklistEntry kw)
    {
        removingKeyword = kw.Keyword;
        removeError = null;

        var result = await UserAccountService.RemoveBlacklistEntryAsync(kw.Keyword);

        if (result.Success)
            keywords.Remove(kw);
        else
            removeError = result.Error;

        removingKeyword = null;
    }

    private async Task HandleDeleteAccount()
    {
        if (string.IsNullOrWhiteSpace(deletePassword)) return;

        isDeleting = true;
        deleteError = null;

        var result = await UserAccountService.DeleteAccountAsync(deletePassword);

        if (result.Success)
        {
            AuthState.ClearUser();
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        deleteError = result.Error;
        isDeleting = false;
    }
}
