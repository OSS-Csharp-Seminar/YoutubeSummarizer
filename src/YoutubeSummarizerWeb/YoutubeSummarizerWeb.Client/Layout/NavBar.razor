@inject AuthStateService AuthState
@inject AuthService AuthService
@inject NotificationService NotificationService
@inject NotificationHubConnection NotificationHub
@inject NavigationManager Navigation
@implements IAsyncDisposable

<nav class="navbar">
    <div class="navbar-inner">
        <a class="navbar-brand" href="/">
            <span class="brand-icon">▶</span>
            <span class="brand-text">YoutubeSummarizer</span>
        </a>

        <div class="navbar-links">
            @if (AuthState.IsLoggedIn)
            {
                <a href="/subscriptions" class="nav-link">Subscriptions</a>
                <a href="/notifications" class="nav-link nav-link-badge">
                    Notifications
                    @if (unreadCount > 0)
                    {
                        <span class="badge">@(unreadCount > 99 ? "99+" : unreadCount)</span>
                    }
                </a>
                @if (AuthState.IsAdmin)
                {
                    <a href="/admin" class="nav-link">Admin</a>
                }

                <div class="user-menu">
                    <button class="user-button" @onclick="ToggleDropdown" @onclick:stopPropagation="true">
                        <span class="user-avatar">@AuthState.DisplayName?[0].ToString().ToUpper()</span>
                        <span class="user-name">@AuthState.DisplayName</span>
                    </button>

                    @if (showDropdown)
                    {
                        <div class="dropdown-overlay" @onclick="CloseDropdown"></div>
                        <div class="dropdown-menu">
                            <button class="dropdown-item" @onclick="GoToAccount">My Account</button>
                            <button class="dropdown-item logout" @onclick="HandleLogout">Logout</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <a href="/login" class="nav-link login-link">Login</a>
            }
        </div>
    </div>
</nav>

@code {
    private bool showDropdown;
    private int unreadCount;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += OnAuthStateChanged;
        NotificationService.OnUnreadCountChanged += OnUnreadChanged;
        NotificationHub.OnNotificationReceived += OnUnreadChanged;
        if (AuthState.IsLoggedIn)
        {
            unreadCount = await NotificationService.GetUnreadCountAsync();
            await NotificationHub.StartAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        if (AuthState.IsLoggedIn)
        {
            unreadCount = await NotificationService.GetUnreadCountAsync();
            await NotificationHub.StartAsync();
        }
        else
        {
            unreadCount = 0;
            await NotificationHub.StopAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async void OnUnreadChanged()
    {
        unreadCount = await NotificationService.GetUnreadCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private void GoToAccount()
    {
        showDropdown = false;
        Navigation.NavigateTo("/account");
    }

    private async Task HandleLogout()
    {
        showDropdown = false;
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        AuthState.OnChange -= OnAuthStateChanged;
        NotificationService.OnUnreadCountChanged -= OnUnreadChanged;
        NotificationHub.OnNotificationReceived -= OnUnreadChanged;
        await NotificationHub.StopAsync();
    }
}
